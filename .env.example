# install.sh writes .env for you and asks for anything missing. This file shows what goes in it. Never commit .env.

# The address of your data room, without https://. Its DNS must point at the server.
DOMAIN=room.example.com

# A long random string, asked for once on the first-run setup screen so that
# nobody else can claim a fresh install. install.sh generates one.
SETUP_TOKEN=change-me

# Email (required). People sign in with a six-digit code sent by email; there
# are no passwords. Without these settings the room stays closed.
# Many hosts block ports 25, 465 and 587; most email services also offer 2525.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address, for example: Acme Data Room <dataroom@example.com>
SMTP_FROM=

# Only when running without Docker (npm run dev / npm start):
# APP_URL=http://localhost:3000
# DATA_DIR=./data
# SMTP_HOST=console   # development only: prints emails, including sign-in codes, to the terminal
