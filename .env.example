# Copy this file to .env and fill it in. Never commit .env.

# The public address of your data room. Must be https:// in production,
# otherwise sign-in cookies are not marked secure.
APP_URL=https://dataroom.example.com

# A long random string. Required on the first-run setup screen so that nobody
# else can claim a fresh install. Generate one with: openssl rand -hex 32
SETUP_TOKEN=change-me

# Where the database and uploaded files live. The Docker image sets this to /data.
# DATA_DIR=/data

# Email (optional). Without it, invitations give you a link to send yourself
# and reminders only appear inside the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address, for example: Acme Data Room <dataroom@example.com>
SMTP_FROM=
