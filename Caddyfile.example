# Caddy gets and renews a TLS certificate automatically.
# Replace the domain, point its DNS at this server, then run: caddy run --config Caddyfile
dataroom.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	request_body {
		max_size 100MB
	}
}
